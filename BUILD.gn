# Standalone GN build for tgcalls on HarmonyOS.
#
# Strategy:
#   * tgcalls is compiled from its own sources (see tgcalls/).
#   * It is linked DYNAMICALLY against the prebuilt libohos_webrtc.so
#     (headers/gen shipped by the WebRTC output tree). The WebRTC source
#     tree is NOT modified; build/, build_overrides/ and third_party/ are
#     symlinked in from the WebRTC checkout.

declare_args() {
  # Root of the prebuilt WebRTC checkout (headers + out/ artifacts).
  tgcall_webrtc_root = "/home/yuanchu/webrtc-harmony-builder/webrtc_latest/src"
  # OHOS native sysroot lib dir (contains libace_napi.z.so / libhilog_ndk.z.so).
  tgcall_sysroot_lib = "/home/yuanchu/command-line-tools/sdk/default/openharmony/native/sysroot/usr/lib"
}

webrtc_out_dir = "$tgcall_webrtc_root/out"

if (target_cpu == "x86_64" || target_cpu == "x64") {
  tgcall_arch_dir = "webrtc_x86_64"
  tgcall_triple = "x86_64-linux-ohos"
  tgcall_arch_defines = [
    "WEBRTC_ARCH_X86_FAMILY",
    "WEBRTC_ARCH_X86_64",
    "WEBRTC_ENABLE_AVX2",
  ]
} else if (target_cpu == "arm") {
  tgcall_arch_dir = "webrtc_arm"
  tgcall_triple = "arm-linux-ohos"
  tgcall_arch_defines = [
    "WEBRTC_ARCH_ARM",
    "WEBRTC_HAS_NEON",
  ]
} else {
  tgcall_arch_dir = "webrtc_arm64"
  tgcall_triple = "aarch64-linux-ohos"
  tgcall_arch_defines = [
    "WEBRTC_ARCH_ARM64",
    "WEBRTC_HAS_NEON",
  ]
}

# Defines mirror the ones used when the prebuilt libohos_webrtc.so was
# compiled, so that ABI-sensitive headers (webrtc / absl) behave identically.
tgcall_common_defines = [
  "__STDC_CONSTANT_MACROS",
  "__STDC_FORMAT_MACROS",
  "_FILE_OFFSET_BITS=64",
  "_LARGEFILE_SOURCE",
  "_LARGEFILE64_SOURCE",
  "HAVE_SYS_UIO_H",
  "OHOS",
  "__MUSL__",
  "_LIBCPP_HAS_MUSL_LIBC",
  "__BUILD_LINUX_WITH_CLANG",
  "__GNU_SOURCE",
  "_GNU_SOURCE",
  "DYNAMIC_ANNOTATIONS_ENABLED=1",
  "WEBRTC_ENABLE_PROTOBUF=1",
  "WEBRTC_STRICT_FIELD_TRIALS=0",
  "WEBRTC_INCLUDE_INTERNAL_AUDIO_DEVICE",
  "RTC_ENABLE_VP9",
  "RTC_ENABLE_H265",
  "RTC_DAV1D_IN_INTERNAL_DECODER_FACTORY",
  "WEBRTC_HAVE_SCTP",
  "WEBRTC_USE_H264",
  "WEBRTC_ENABLE_LIBEVENT",
  "WEBRTC_NON_STATIC_TRACE_EVENT_HANDLERS=1",
  "WEBRTC_POSIX",
  "WEBRTC_OHOS",
  "WEBRTC_LINUX",
  "ABSL_ALLOCATOR_NOTHROW=1",
  # tgcalls
  "TGCALL_USE_INSTANCE_V2_REFERENCE_IMPL",
]

shared_library("libtgcall") {
  sources = [
    "tgcalls/AudioDeviceHelper.cpp",
    "tgcalls/ChannelManager.cpp",
    "tgcalls/CodecSelectHelper.cpp",
    "tgcalls/CryptoHelper.cpp",
    "tgcalls/EncryptedConnection.cpp",
    "tgcalls/FieldTrialsConfig.cpp",
    "tgcalls/Instance.cpp",
    "tgcalls/LogSinkImpl.cpp",
    "tgcalls/Message.cpp",
    "tgcalls/SctpDataChannelProviderInterfaceImpl.cpp",
    "tgcalls/StaticThreads.cpp",
    "tgcalls/ThreadLocalObject.cpp",
    "tgcalls/TurnCustomizerImpl.cpp",
    "tgcalls/VideoCaptureInterface.cpp",
    # Official VideoCaptureInterfaceImpl.cpp (real video capture support).
    # It pulls in MediaManager.h, whose sigslot.h include is provided by
    # tgcalls/rtc_base/third_party/sigslot/sigslot.h (sigslot was removed
    # from newer WebRTC). Compiles against the new WebRTC core.
    "tgcalls/VideoCaptureInterfaceImpl.cpp",
    # OHOS PlatformInterface: video codecs + camera capture via libohos_webrtc.so.
    "tgcalls/platform/ohos/OhosInterface.cpp",
    "tgcalls/platform/ohos/VideoCameraCapturer.cpp",
    "tgcalls/third-party/json11.cpp",
    "tgcalls/utils/gzip.cpp",
    "tgcalls/v2/ContentNegotiation.cpp",
    "tgcalls/v2/ExternalSignalingConnection.cpp",
    "tgcalls/v2/InstanceV2ReferenceImpl.cpp",
    "tgcalls/v2/NativeNetworkingImpl.cpp",
    "tgcalls/v2/RawTcpSocket.cpp",
    "tgcalls/v2/ReflectorPort.cpp",
    "tgcalls/v2/ReflectorRelayPortFactory.cpp",
    "tgcalls/v2/Signaling.cpp",
    "tgcalls/v2/SignalingConnection.cpp",
    "tgcalls/v2/SignalingEncryption.cpp",
    "tgcalls/v2/SignalingSctpConnection.cpp",
    "tgcalls/v2_4_0_0/Signaling_4_0_0.cpp",
    # Tele4Watch-style NAPI bridge (compiled into libtgcall.so).
    # Exposes a "tgcall" NAPI module: startCall/feedSignalingData/... for ArkTS.
    "bridge/base64_util.cpp",
    "bridge/diagnostic_tgcall_instance.cpp",
    "bridge/InstanceV4_0_0Impl.cpp",
    "bridge/InstanceV13_0_0Impl.cpp",
    "bridge/napi_init.cpp",
    "bridge/real_tgcall_factory_registry.cpp",
    "bridge/tgcall_native.cpp",
    "bridge/tgcall_session.cpp",
    "bridge/tgcall_video_capturer.cpp",
    "bridge/webk_signaling_adapter.cpp",
  ]

  include_dirs = [
    ".",  # tgcall_webrtc_compat.h
    "bridge",
    "tgcalls",
    "tgcalls/v2",
    tgcall_webrtc_root,
    "$tgcall_webrtc_root/third_party/abseil-cpp",
    "$tgcall_webrtc_root/third_party/boringssl/src/include",
    "$webrtc_out_dir/$tgcall_arch_dir/gen",
    # OHOS ADM: CreateDefaultAudioDeviceModule() (ohos_audio_device_module.h).
    "$tgcall_webrtc_root/sdk/ohos/src/ohos_webrtc/audio_device",
    "$tgcall_webrtc_root/sdk/ohos/src/node-addon-api",
    # OHOS platform stack: camera_capturer.h, video/video_track_source.h,
    # video_codec/software_video_*_factory.h.
    "$tgcall_webrtc_root/sdk/ohos/src/ohos_webrtc",
  ]

  defines = tgcall_common_defines + tgcall_arch_defines + [
    # sdk/ohos headers (egl_context.h -> node-addon-api/napi.h) require these;
    # matches how libohos_webrtc.so itself was built.
    "NAPI_DISABLE_CPP_EXCEPTIONS",
    "NODE_ADDON_API_DISABLE_DEPRECATED",
    "NDK_HELPER_DISABLE_CPP_EXCEPTIONS",
  ]

  # -fno-rtti matches how libohos_webrtc.so was built (Chromium default).
  cflags = [
    "-include",
    "tgcall_webrtc_compat.h",
    "-fno-rtti",
  ]

  lib_dirs = [
    "$webrtc_out_dir/$tgcall_arch_dir",
    "$tgcall_sysroot_lib/$tgcall_triple",
    # OHOS llvm runtime libs (libunwind.a / libc++.a live here, not in sysroot).
    "/home/yuanchu/command-line-tools/sdk/default/openharmony/native/llvm/lib/$tgcall_triple",
  ]
  # ohos_webrtc: prebuilt dynamic lib (exports webrtc/cricket/boringssl/opus/absl).
  # z: system zlib; libohos_webrtc.so does not export zlib symbols and
  #    tgcalls/utils/gzip.cpp needs inflate()/inflateEnd().
  # ace_napi.z / hilog_ndk.z / ohaudio: OHOS system libs used by the NAPI
  # bridge (napi_module_register, OH_LOG_Print, OHOS audio).
  # ohcamera: OHOS camera NDK (OH_CameraManager_*) called directly by
  # OhosInterface::makeVideoSource (via the inline ohos::CameraManager helper).
  libs = [
    "ohos_webrtc",
    "ace_napi.z",
    "hilog_ndk.z",
    "ohaudio",
    "ohcamera",
    "z",
  ]

  ldflags = [
    "-Wl,-soname,libtgcall.so",
    "-Wl,-z,defs",
    # OHOS toolchain links against compiler-rt (crt1.o/crti.o/crtn.o in
    # sysroot) instead of the GNU crtbeginS.o/crtendS.o, which the OHOS
    # sysroot does not ship. -nostartfiles keeps clang from injecting the
    # GNU shared-library crt objects at all (a .so has no crt1.o entry).
    "--rtlib=compiler-rt",
    "-nostartfiles",
  ]

  output_name = "tgcall"
}
